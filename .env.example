APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
API_BASE_PATH=/api

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nome_do_banco
DB_USERNAME=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_CHARSET=utf8mb4

# OBRIGATORIO: lista de origens liberadas (separadas por virgula). Sem isso, o CORS
# fecha por padrao (fail-closed) e nenhuma origem cross-site consegue chamar a API.
CORS_ALLOWED_ORIGINS=https://seudominio.com.br,http://localhost:5173,http://127.0.0.1:5173

# Chave para assinar o token de sessao do painel (HMAC). OBRIGATORIA.
# Gere uma aleatoria e guarde em segredo:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Login do painel administrativo (credencial unica da equipe).
# 1. Escolha um usuario (ex.: nome curto).
# 2. Gere o hash da senha (bcrypt), nunca guarde a senha em texto:
#    php -r "echo password_hash('SUA-SENHA-FORTE', PASSWORD_DEFAULT);"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

LOCK_TTL_MINUTES=30