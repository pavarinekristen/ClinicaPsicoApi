APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
API_BASE_PATH=/api

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nome_do_banco
DB_USERNAME=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_CHARSET=utf8mb4

CORS_ALLOWED_ORIGINS=https://seudominio.com.br,http://localhost:5173,http://127.0.0.1:5173
# RECOMENDADO: guarde somente o HASH SHA-256 do token (a senha nunca fica no arquivo).
# 1. Crie um token forte (32+ caracteres aleatorios) e guarde num gerenciador de senhas.
# 2. Gere o hash: php -r "echo hash('sha256', 'SEU-TOKEN-AQUI');"
# 3. Cole o resultado abaixo. Quando ADMIN_TOKEN_HASH existe, ADMIN_TOKEN e ignorado.
ADMIN_TOKEN_HASH=
# Alternativa (menos segura, dev local): token em texto puro.
# Tokens fracos (<16 chars) ou o placeholder sao recusados em producao.
#ADMIN_TOKEN=troque-este-token
LOCK_TTL_MINUTES=30